# Copy this file to `.env` and fill in your HuggingFace token.
#
# HunyuanWorld-1.0 builds on the gated FLUX.1-dev model. Before it will work:
#   1. Accept the license at https://huggingface.co/black-forest-labs/FLUX.1-dev
#   2. Create an access token (read scope) at https://huggingface.co/settings/tokens
#   3. Paste it below and save this file as `.env` (NOT committed to git).
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
